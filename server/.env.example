# Server
NODE_ENV=development
PORT=5000

# Database (MongoDB Atlas connection string)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/retain?retryWrites=true&w=majority

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# CORS origins of the frontend (comma-separated)
# Local dev: http://localhost:5173,http://localhost:5174
# Production: add your Vercel URL, e.g. https://your-app.vercel.app
# Entries containing * are wildcards, e.g. https://*-your-team.vercel.app
# to also accept Vercel preview deployments (https://app-git-branch-team.vercel.app)
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174,https://summative-project-retain-app.vercel.app,https://*-your-team.vercel.app